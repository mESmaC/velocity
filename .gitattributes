# Scout and reviewer regression scripts: preserve their exact bytes. Covers
# every file directly in stress/, so a new script needs no line here.
/stress/* -text
/stress/pr3-font-csp.py -text whitespace=cr-at-eol

# Generated files: on a merge with master, keep master's copy and regenerate
# (AGENTS.md, Shared files). Needs scripts/Setup-DevMachine.ps1; without it git
# uses its normal text merge.
/ui/src/lib/bindings.ts merge=velocity-take-master linguist-generated=true
/Cargo.lock merge=velocity-take-master
/ui/pnpm-lock.yaml merge=velocity-take-master

# Aeneas output: generated Lean, kept out of language statistics and diffs.
proofs/**/Generated/** linguist-generated=true
